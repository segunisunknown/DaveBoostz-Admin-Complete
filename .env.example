# GEMINI_API_KEY: Optional, injected by AI Studio runtime if needed.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted URL injected by AI Studio runtime.
APP_URL="MY_APP_URL"

# Supabase Public Configuration (Required for live Auth, PostgreSQL, and Storage)
# NEVER put service_role or secret database keys in VITE_* frontend variables.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY=""
